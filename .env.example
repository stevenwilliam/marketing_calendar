# marketing_calendar — the documented configuration surface.
# The real file lives at /etc/marketing_calendar/marketing_calendar.env,
# is owned by root, and is never in git. Copy this, fill it, keep it out.

MC_ENV=development                    # development | production
MC_HTTP_ADDR=127.0.0.1:8093           # loopback only; nginx is the way in

# Required. The service refuses to start without these.
MC_DATABASE_URL=postgres://mc_app:CHANGEME@127.0.0.1:5432/marketing_calendar?sslmode=disable
MC_TEST_DATABASE_URL=postgres://mc_app:CHANGEME@127.0.0.1:5432/marketing_calendar_test?sslmode=disable
MC_JWT_SECRET=CHANGEME                # minimum 32 characters; boot fails below that

MC_ACCESS_TOKEN_TTL=15m
MC_REFRESH_TOKEN_TTL=720h
MC_TOTP_ISSUER="Marketing Calendar"   # shown in the authenticator app

MC_SMTP_HOST=127.0.0.1                # mailpit in dev
MC_SMTP_PORT=1025
MC_SMTP_FROM=marketing-calendar@sfg.local
MC_NOTIFY_ENABLED=true

MC_S3_ENDPOINT=                       # MinIO; unset disables object storage
MC_S3_ACCESS_KEY=
MC_S3_SECRET_KEY=
MC_S3_BUCKET=marketing-calendar
MC_S3_USE_SSL=false

MC_IMPORT_DROP_PATH=/srv/marketing_calendar/import
MC_LOG_LEVEL=info                     # debug | info | warn | error
MC_METRICS_ENABLED=true
MC_TRUSTED_PROXIES=127.0.0.1          # nginx only
