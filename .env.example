# marketing_calendar — configuration surface.
# Copy to .env for local development (git-ignored, chmod 0600), or install at
# /etc/marketing_calendar/marketing_calendar.env for a deployment (0640).
#
# Generate this project's OWN secrets. Never copy another project's signing
# key: a shared key makes a token minted for one system valid in the other.
#   openssl rand -base64 48   # JWT_SIGNING_KEY
#   openssl rand -base64 32   # TOTP_ENCRYPTION_KEY

APP_ENV=development                 # development | staging | production | test
APP_NAME=marketing_calendar
APP_BIND=127.0.0.1                  # loopback only; nginx is the way in
APP_PORT=                           # choose a free port — see docs/11 §5
APP_BASE_URL=
APP_TIMEZONE=Asia/Jakarta
APP_DEFAULT_LOCALE=id-ID
APP_LOCALES=id-ID,en
LOG_LEVEL=info

DATABASE_URL=postgres://marketing_calendar:CHANGE_ME@127.0.0.1:5432/marketing_calendar?sslmode=disable
TEST_DATABASE_URL=postgres://marketing_calendar:CHANGE_ME@127.0.0.1:5432/marketing_calendar_test?sslmode=disable

JWT_SIGNING_KEY=
TOTP_ENCRYPTION_KEY=
TOTP_ISSUER=marketing_calendar
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

SMTP_HOST=127.0.0.1                 # mailpit in dev — nothing leaves the box
SMTP_PORT=1025
SMTP_FROM_EMAIL=no-reply@marketing-calendar.internal
SMTP_FROM_NAME=Marketing Calendar

MINIO_ENDPOINT=127.0.0.1:9002
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=marketing-calendar
MINIO_USE_SSL=false

WAHA_URL=http://127.0.0.1:3000      # phase 2
WAHA_SESSION=marketing_calendar
WAHA_API_KEY=
WAHA_ENABLED=false

IMPORT_DROP_PATH=/srv/marketing_calendar/import
CORS_ALLOWED_ORIGINS=
